[Unit]
Description=Hermes OpenAI-compatible bridge for Dolibarr AI Q&A
After=network-online.target

[Service]
Type=simple
WorkingDirectory=/root/.hermes/skills/dolibarr-database
EnvironmentFile=/root/.hermes/hermes-openai-bridge.env
ExecStart=/usr/local/lib/hermes-agent/venv/bin/python /root/.hermes/skills/dolibarr-database/scripts/hermes_openai_bridge.py
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
